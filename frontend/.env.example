# ===================================
# Peykan Tourism Platform - Frontend Environment Configuration
# ===================================
# Copy this file to .env.local for development or .env.production for production
# IMPORTANT: Never commit .env files to version control

# ===================================
# Node Environment
# ===================================
# Set to 'production' for production builds, 'development' for local development
NODE_ENV=production

# ===================================
# API Configuration
# ===================================
# Public API URL - accessible from browser
# For production with nginx proxy, use relative path: /api/v1
# For development, use full URL: http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# ===================================
# Site Configuration
# ===================================
# Public site URL - used for canonical URLs, social sharing, etc.
NEXT_PUBLIC_SITE_URL=https://peykantravelistanbul.com

# ===================================
# Google OAuth Configuration
# ===================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# This is the client ID for Google Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here_change_this

# ===================================
# Feature Flags (Optional)
# ===================================
# Enable/disable features
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_CHAT=false

# ===================================
# Analytics (Optional)
# ===================================
# Google Analytics tracking ID
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Google Tag Manager ID
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===================================
# Social Media (Optional)
# ===================================
# Social media links for footer/header
# NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/yourpage
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourpage
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/yourpage

# ===================================
# Map Configuration (Optional)
# ===================================
# Google Maps API key for location features
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===================================
# Payment Configuration (Optional)
# ===================================
# Stripe publishable key (if using Stripe)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ===================================
# Telemetry
# ===================================
# Disable Next.js telemetry (recommended for privacy)
NEXT_TELEMETRY_DISABLED=1

# ===================================
# Development Settings
# ===================================
# These settings are only used in development mode

# Backend API URL for server-side requests (development only)
# API_URL=http://localhost:8000

# Enable verbose logging (development only)
# NEXT_PUBLIC_DEBUG=true

# ===================================
# Production Build Settings
# ===================================
# These settings affect the production build

# Enable source maps in production (not recommended for security)
# NEXT_PUBLIC_ENABLE_SOURCE_MAPS=false

# Enable React strict mode
# NEXT_PUBLIC_STRICT_MODE=true

# ===================================
# Image Optimization
# ===================================
# Image optimization settings (handled by next.config.js)
# These are informational only

# Supported image formats: webp, avif
# Device sizes: 640, 750, 828, 1080, 1200, 1920, 2048, 3840
# Image sizes: 16, 32, 48, 64, 96, 128, 256, 384

# ===================================
# Notes
# ===================================
# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# 2. Variables without NEXT_PUBLIC_ are only available server-side
# 3. Replace all "change_this" values with actual values
# 4. For development, copy this to .env.local
# 5. For production, copy this to .env.production
# 6. Never commit .env.local or .env.production to version control
# 7. Keep backups of environment files in a secure location
# 8. In production with nginx proxy:
#    - Use NEXT_PUBLIC_API_URL=/api/v1 (relative path)
#    - Nginx will proxy /api/v1/* to backend container
# 9. In development without nginx:
#    - Use NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1 (full URL)
#    - Next.js will proxy directly to backend

# ===================================
# Environment-Specific Examples
# ===================================

# Development (.env.local):
# NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_DEBUG=true

# Production (.env.production):
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_SITE_URL=https://peykantravelistanbul.com
# NEXT_TELEMETRY_DISABLED=1
