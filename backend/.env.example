# ===================================
# Peykan Tourism Platform - Backend Environment Configuration
# ===================================
# Copy this file to .env and fill in the actual values
# IMPORTANT: Never commit .env file to version control

# ===================================
# Django Core Settings
# ===================================
# Generate a strong secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your_very_secure_secret_key_here_minimum_50_characters_change_this

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=peykantravelistanbul.com,www.peykantravelistanbul.com,localhost,127.0.0.1,backend,peykan_backend

# ===================================
# Database Configuration (PostgreSQL)
# ===================================
# Full database URL format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://peykan_user:your_secure_password@postgres:5432/peykan

# ===================================
# Redis Configuration
# ===================================
# Redis URL with password (database 1 for cache and Celery)
REDIS_URL=redis://:your_redis_password@redis:6379/1

# ===================================
# Celery Configuration
# ===================================
# Celery broker URL (uses Redis)
CELERY_BROKER_URL=redis://:your_redis_password@redis:6379/1

# Celery result backend (uses Redis)
CELERY_RESULT_BACKEND=redis://:your_redis_password@redis:6379/1

# ===================================
# CORS & CSRF Settings
# ===================================
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=https://peykantravelistanbul.com,https://www.peykantravelistanbul.com,http://localhost:3000

# Comma-separated list of trusted origins for CSRF
CSRF_TRUSTED_ORIGINS=https://peykantravelistanbul.com,https://www.peykantravelistanbul.com,http://localhost:3000

# Allow all origins (set to False in production)
CORS_ALLOW_ALL_ORIGINS=False

# ===================================
# Internationalization
# ===================================
# Comma-separated list of supported languages
LANGUAGES=fa,en,tr

# Default language code
DEFAULT_LANGUAGE=fa

# ===================================
# Currency Settings
# ===================================
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,EUR,TRY,IRR

# ===================================
# Email Configuration (SMTP)
# ===================================
# Email backend (use console for development, smtp for production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@peykantravelistanbul.com
EMAIL_HOST_PASSWORD=your_email_app_password_here_change_this
DEFAULT_FROM_EMAIL=noreply@peykantravelistanbul.com
SUPPORT_EMAIL=support@peykantravelistanbul.com

# ===================================
# Google OAuth Configuration
# ===================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here_change_this
GOOGLE_CLIENT_SECRET=your_google_client_secret_here_change_this

# ===================================
# SMS Configuration (Kavenegar)
# ===================================
# Get API key from: https://panel.kavenegar.com/client/setting/account
KAVENEGAR_API_KEY=your_kavenegar_api_key_here_change_this

# ===================================
# Payment Gateway Configuration
# ===================================
# Payment gateway type (mock, stripe, etc.)
PAYMENT_GATEWAY=mock

# Payment gateway secret key
PAYMENT_SECRET_KEY=your_payment_gateway_secret_key_here_change_this

# ===================================
# JWT Settings
# ===================================
# JWT secret key (should be different from Django SECRET_KEY)
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this

# JWT access token lifetime in minutes (default: 120 = 2 hours)
JWT_ACCESS_TOKEN_LIFETIME=120

# JWT refresh token lifetime in minutes (default: 1440 = 24 hours)
JWT_REFRESH_TOKEN_LIFETIME=1440

# ===================================
# Static & Media Files
# ===================================
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=staticfiles

# ===================================
# File Upload Settings
# ===================================
# Maximum file upload size in MB
FILE_UPLOAD_MAX_MEMORY_SIZE=10
DATA_UPLOAD_MAX_MEMORY_SIZE=10

# ===================================
# Security Settings
# ===================================
# Session cookie settings
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_AGE=86400

# CSRF cookie settings
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_DOMAIN=.peykantravelistanbul.com

# HTTPS redirect (set to False if nginx handles SSL)
SECURE_SSL_REDIRECT=False

# HSTS settings
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Security headers
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin

# ===================================
# Cache Settings
# ===================================
CACHE_KEY_PREFIX=peykan_prod_
CACHE_TIMEOUT=300

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===================================
# Logging Configuration
# ===================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/django.log

# ===================================
# Frontend Configuration
# ===================================
FRONTEND_URL=https://peykantravelistanbul.com

# WhatsApp support number (with country code)
WHATSAPP_SUPPORT_NUMBER=989123456789

# ===================================
# Docker Secrets
# ===================================
# These are used by docker-compose.yml
POSTGRES_PASSWORD=your_secure_database_password_here_change_this
REDIS_PASSWORD=your_redis_password_here_change_this

# ===================================
# AWS S3 Storage (Optional)
# ===================================
# Uncomment and configure if using AWS S3 for media files
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_S3_REGION_NAME=your_region
# AWS_S3_CUSTOM_DOMAIN=your_cdn_domain

# ===================================
# Monitoring & Error Tracking (Optional)
# ===================================
# Sentry DSN for error tracking
# SENTRY_DSN=your_sentry_dsn_here_optional

# ===================================
# Database Connection Settings
# ===================================
DATABASE_CONNECTION_MAX_AGE=600
DATABASE_CONNECTION_HEALTH_CHECKS=True

# ===================================
# Notes
# ===================================
# 1. Replace all "change_this" values with actual secure values
# 2. Use strong passwords (minimum 16 characters, mix of letters, numbers, symbols)
# 3. Never commit .env file to version control
# 4. Keep backups of .env file in a secure location
# 5. Rotate secrets regularly (every 90 days recommended)
# 6. For production, ensure DEBUG=False and use strong SECRET_KEY
# 7. Configure proper ALLOWED_HOSTS for your domain
# 8. Use HTTPS in production (SECURE_SSL_REDIRECT=True if Django handles SSL)
